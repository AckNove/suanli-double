# 算力双项目 MVP 环境变量示例
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交。
# 本期不读取 .env 文件本身，请在 PowerShell 里 export 后运行，例如：
#   $env:COMPUTE_OPERATOR = "Arthur"
#   $env:COMPUTE_L2_LOCKED = "1"

# 数据目录（默认 <repo>/data）。设成别的盘可把研究库与私密库放到加密卷上。
# COMPUTE_DATA_DIR=D:\compute-data

# L2 审计日志里记录的操作者名称（默认 local-operator）
# COMPUTE_OPERATOR=Arthur

# 设为 1 可在本机整体禁用 L2 商务敏感数据访问（借用他人机器演示时用）
# COMPUTE_L2_LOCKED=0

# ---- 以下本期未接线，仅占位；密钥绝不入库（L3） ----
# 搜索服务（本期未接任何付费 API，保持注释状态）
# SEARCH_PROVIDER=
# SEARCH_API_KEY=

# LLM（本期代码不调用任何 LLM；研究报告的结论需人工撰写）
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
